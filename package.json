{
  "name": "sivree-app",
  "version": "1.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "audit": "node scripts/audit.mjs",
    "build:site": "node scripts/build-static.mjs",
    "export": "tsx --env-file-if-exists=.env scripts/export-data.ts",
    "check:locales": "node scripts/check-locales.mjs",
    "test:xss": "node scripts/test-xss.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "test:visit": "node scripts/test-visit.mjs",
    "test:onboarding": "node scripts/test-onboarding.mjs",
    "test:hashtags": "node scripts/test-hashtags.mjs",
    "test:refresh": "node scripts/test-refresh.mjs",
    "test:feeds": "tsx scripts/test-feeds.ts",
    "test:saved": "tsx scripts/test-saved.ts",
    "test:tiers": "tsx scripts/test-tiers.ts",
    "test:migrate": "tsx scripts/test-migrate.ts",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "check:source-names": "tsx scripts/check-source-names.ts",
    "check:brand": "node scripts/check-brand.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@mozilla/readability": "^0.6.0",
    "express": "^5.3.0",
    "jsdom": "^30.1.3",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.0.0",
    "unpdf": "1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
